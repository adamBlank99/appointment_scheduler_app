# Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Optional override for another Cloudflare Turnstile widget's public site key.
# This repository includes its production widget's public site key by default.
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
